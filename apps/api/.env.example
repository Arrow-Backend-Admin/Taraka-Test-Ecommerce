# Copy to .env and replace placeholders. Never commit the real file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://santvana:change-me@localhost:5432/santvana
ADMIN_API_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=http://localhost:3000
STOREFRONT_URL=http://localhost:3000

# Salt for hashing guest IP addresses used by reservation caps.
CART_IP_HASH_SECRET=replace-with-a-long-random-token

# Razorpay hosted checkout. Test keys only in development. Live keys are
# refused unless APP_ENV=production and the launch check passes.
# Create test keys in the Razorpay dashboard; never paste them into a commit.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local review only. Refused when APP_ENV=production.
RAZORPAY_MOCK=true
RAZORPAY_API_BASE=https://api.razorpay.com/v1
ORDER_PAYMENT_WINDOW_MINUTES=10

# Transactional email. Mailpit (docker compose) listens on localhost:1025 and
# shows messages at http://localhost:8025.
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=orders@santvana.example

# Seller details are placeholders until the founder supplies them. They are
# stored on each order and are not printed in the confirmation email while the
# GSTIN is unresolved.
SELLER_STATE=[TO CONFIRM: founder]
SELLER_GSTIN=[TO CONFIRM: founder]

# OpenTelemetry is off by default. Set true and point at a collector in production.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=santvana-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=key=value,key2=value2

# Optional stock-photo API keys for a future placeholder refresh. Never commit
# real values. The committed Phase 4 placeholder set uses Wikimedia Commons and
# needs no key.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
