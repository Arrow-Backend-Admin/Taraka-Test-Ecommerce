# Copy to .env and replace placeholders. Never commit the real file.
DATABASE_URL=postgresql+psycopg://santvana:change-me@localhost:5432/santvana
ADMIN_API_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=http://localhost:3000

# OpenTelemetry is off by default. Set true and point at a collector in production.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=santvana-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=key=value,key2=value2
