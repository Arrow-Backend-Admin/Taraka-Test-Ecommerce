# Copy to .env.local and adjust if needed. Never commit the real file.
# API origin used by the server-rendered catalogue page.
API_URL=http://localhost:8000

# API origin used by browser calls for live stock and the guest cart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local draft preview. Ignored when APP_ENV=production.
APP_ENV=development
PREVIEW_DRAFTS=false
