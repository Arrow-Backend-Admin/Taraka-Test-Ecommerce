{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Sāntvana concept design tokens",
    "version": "0.1.0",
    "date": "2026-10-30",
    "status": "concept — not for print, domain or ad spend until the attorney opinion",
    "note": "Colour ratios are calculated in contrast.py. Logo sizes are governed by logo-usage.md; the token values are defaults, not a substitute for the minimum-size rule."
  },
  "color": {
    "ink": { "value": "#171614", "role": "primary text, strong borders, dark surfaces" },
    "paper": { "value": "#F5F1E8", "role": "default page and packaging background" },
    "ground": { "value": "#2B2722", "role": "dark editorial surface" },
    "bone": { "value": "#EAE3D6", "role": "raised surface, quiet section fill" },
    "sand": { "value": "#D9CBB4", "role": "warm neutral surface; use ink for text" },
    "stone": { "value": "#8C8578", "role": "decorative rules and 3:1 UI borders; not body text" },
    "muted": { "value": "#6B655B", "role": "secondary text on paper and bone" },
    "clay": { "value": "#A8452B", "role": "primary action, links, focus, one accent per screen" },
    "clay-hover": { "value": "#8F3A24", "role": "primary action hover" },
    "clay-pressed": { "value": "#7A301D", "role": "primary action pressed" },
    "clay-light": { "value": "#D98B6F", "role": "accent text on ink or ground" },
    "moss": { "value": "#3E4A3A", "role": "secondary dark surface, quiet emphasis" },
    "moss-hover": { "value": "#323C2F", "role": "moss hover" },
    "moss-light": { "value": "#A8B5A0", "role": "muted text on ink or ground" },
    "slate": { "value": "#35424C", "role": "informational dark surface" },
    "ochre": { "value": "#946200", "role": "warning text and fill; not a decorative pastel" },
    "red": { "value": "#A62B22", "role": "error text and fill" },
    "green": { "value": "#2F6B4F", "role": "success text and fill" },
    "blue": { "value": "#2E5E7E", "role": "informational text and fill" },
    "white": { "value": "#FFFFFF", "role": "reserved for optical highlights and image masks only" }
  },
  "semantic": {
    "surface-default": { "value": "{color.paper}" },
    "surface-raised": { "value": "{color.bone}" },
    "surface-inverse": { "value": "{color.ink}" },
    "surface-editorial": { "value": "{color.ground}" },
    "text-primary": { "value": "{color.ink}" },
    "text-secondary": { "value": "{color.muted}" },
    "text-inverse": { "value": "{color.paper}" },
    "text-inverse-secondary": { "value": "{color.sand}" },
    "text-accent": { "value": "{color.clay}" },
    "text-accent-inverse": { "value": "{color.clay-light}" },
    "action-primary": { "value": "{color.clay}" },
    "action-primary-hover": { "value": "{color.clay-hover}" },
    "action-primary-pressed": { "value": "{color.clay-pressed}" },
    "focus-ring": { "value": "{color.clay}" },
    "border-strong": { "value": "{color.ink}" },
    "border-subtle": { "value": "{color.stone}" },
    "status-success": { "value": "{color.green}" },
    "status-warning": { "value": "{color.ochre}" },
    "status-error": { "value": "{color.red}" },
    "status-info": { "value": "{color.blue}" }
  },
  "font": {
    "display": { "value": "var(--font-archivo), 'Archivo', 'Segoe UI', sans-serif" },
    "body": { "value": "var(--font-inter), 'Inter', 'Segoe UI', sans-serif" },
    "devanagari": { "value": "var(--font-noto-deva), 'Noto Sans Devanagari', 'Nirmala UI', sans-serif" },
    "devanagari-test": { "value": "var(--font-noto-serif-deva), 'Noto Serif Devanagari', 'Nirmala UI', serif" },
    "weight-regular": { "value": "400" },
    "weight-medium": { "value": "500" },
    "weight-semibold": { "value": "600" },
    "weight-bold": { "value": "700" },
    "tracking-display": { "value": "-0.035em" },
    "tracking-body": { "value": "0" },
    "tracking-micro": { "value": "0.14em" },
    "deva-optical-factor-display": { "value": "0.64", "note": "Devanagari wordmark size ÷ Latin wordmark size in the horizontal lockup; adjust optically, not mechanically." },
    "deva-optical-factor-body": { "value": "1.05", "note": "Start at 1.05× the Latin body size, then check line height and व/न distinction." }
  },
  "fontSize": {
    "micro": { "value": "0.75rem", "lineHeight": "1.4" },
    "small": { "value": "0.875rem", "lineHeight": "1.5" },
    "body": { "value": "1rem", "lineHeight": "1.6" },
    "body-large": { "value": "1.125rem", "lineHeight": "1.65" },
    "heading-small": { "value": "1.5rem", "lineHeight": "1.25" },
    "heading": { "value": "2rem", "lineHeight": "1.15" },
    "display-small": { "value": "clamp(2.5rem, 5vw, 3.5rem)", "lineHeight": "1.02" },
    "display": { "value": "clamp(3.5rem, 7vw, 5.5rem)", "lineHeight": "0.98" },
    "display-large": { "value": "clamp(4.5rem, 10vw, 8rem)", "lineHeight": "0.92" }
  },
  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.25rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" },
    "20": { "value": "5rem" },
    "24": { "value": "6rem" },
    "32": { "value": "8rem" }
  },
  "radius": {
    "none": { "value": "0" },
    "sm": { "value": "0.25rem" },
    "md": { "value": "0.5rem" },
    "lg": { "value": "0.75rem" },
    "symbol": { "value": "1rem", "note": "16 units on the 64-unit ground mark" },
    "pill": { "value": "999px" }
  },
  "border": {
    "hairline": { "value": "1px" },
    "strong": { "value": "2px" },
    "ground-line": { "value": "4px", "note": "The Long Line; never ends in an arrowhead" }
  },
  "shadow": {
    "none": { "value": "none", "note": "No soft shadows, glows or floating cards in the core system" }
  },
  "motion": {
    "duration-fast": { "value": "120ms" },
    "duration-base": { "value": "220ms" },
    "ease-standard": { "value": "cubic-bezier(0.2, 0.7, 0.2, 1)" },
    "reduce-motion": { "value": "prefers-reduced-motion: reduce" }
  },
  "layout": {
    "max-width": { "value": "80rem" },
    "gutter-mobile": { "value": "1.25rem" },
    "gutter-desktop": { "value": "2.5rem" },
    "section-space-mobile": { "value": "4rem" },
    "section-space-desktop": { "value": "7rem" }
  },
  "logo": {
    "devanagari-floor-screen": { "value": "20px", "note": "Absolute floor. At 1× use 28px; below 20px use the monogram or symbol." },
    "devanagari-practical-1x": { "value": "28px" },
    "devanagari-print-floor": { "value": "6mm", "note": "Measured wordmark height, not point size. Physical proof pending." },
    "clear-space": { "value": "1× Latin cap height", "note": "Measured from the tallest ascender; minimum 24px at screen sizes." },
    "symbol-clear-space": { "value": "0.5× symbol width" },
    "monogram-use": { "value": "16–19px and favicon" },
    "symbol-use": { "value": "20–31px, avatar, app icon" },
    "horizontal-use": { "value": "28px Deva line and above at 1× (parked); 20px and above at DPR ≥ 1.5" }
  }
}
